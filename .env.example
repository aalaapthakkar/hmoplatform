# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings > API). London region.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Base URL used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string for Drizzle migrations (server only).
# Project Settings > Database > Connection string (session pooler).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Optional: a test-only login for npm run test:e2e:live. The tests sign up
# with it the first time and create an "E2E test organisation" for it.
# Never use your real account here.
E2E_EMAIL=
E2E_PASSWORD=

# E-signing, test mode only. Dropbox Sign: Settings > API > API key (test mode is always used).
DROPBOX_SIGN_API_KEY=
# Optional: "fake" uses the built-in pretend provider (automated tests only).
ESIGN_PROVIDER=
# A long random string; after setting it, run npm run esign:setup.
ESIGN_RELAY_SECRET=

# Email, sent through Resend (resend.com > API Keys). EMAIL_FROM must use a
# domain you've verified in Resend, e.g. "Northside Lettings <hello@northside.co.uk>".
RESEND_API_KEY=
EMAIL_FROM=
# Optional: "fake" never sends anything (automated tests and trying things out).
EMAIL_PROVIDER=
# A long random string (32+ characters) for the daily reminder job; set the same
# value in Vercel, then run npm run cron:setup.
CRON_SECRET=
